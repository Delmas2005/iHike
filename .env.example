# Copy to .env for local runs (never commit .env). On the Hugging Face Space, set these
# in Settings > Variables and secrets instead. Every variable is optional: the app starts
# without any of them and reports which features are off at /api/config.

# --- Secrets ---------------------------------------------------------------

# OpenRouteService API key (https://openrouteservice.org/dev/#/signup).
# Needed for routing and as the second place search. Without it, no route can be planned.
ORS_API_KEY=

# Hugging Face token. Enables the LLM (request parsing refinement and briefing) through
# Inference Providers, and saving shared hikes to HIKES_DATASET.
# Prefer a fine-grained token limited to "Inference Providers" and write access to the dataset.
HF_TOKEN=

# --- Variables -------------------------------------------------------------

# Dataset repository that stores shared hikes and their photos, e.g. your-name/ihike-hikes.
# Created as private on first start. Needs HF_TOKEN. Without it, shared hikes are lost on restart.
HIKES_DATASET=

# Chat model used for the briefing and to refine request parsing.
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# faster-whisper model size for voice requests: tiny, base, small, ...
WHISPER_MODEL=base

# open_clip model used to recognise plants and animals in photos.
SPECIES_MODEL=hf-hub:imageomics/bioclip

# Port of the web server. The Space expects 7860.
GRADIO_SERVER_PORT=7860
